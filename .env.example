# Braidly — copy this file to .env and fill in your keys. NEVER commit .env.
# All keys stay on your machine; the gateway is the only module that reads them.

# Groq (free) — primary smart brain. Get a key at console.groq.com
GROQ_API_KEY=

# OpenRouter (free) — automatic fallback when Groq rate-limits. Get a key at openrouter.ai
OPENROUTER_API_KEY=
# OpenRouter free model to use as fallback (change freely)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama (local, no key) — cheap repetitive work + last-resort fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Server (BRAIDLY_PORT wins; falls back to PORT if set, else 3000)
BRAIDLY_PORT=3000

# How many recent messages the AI facilitator sees as context
MAX_HISTORY_MESSAGES=20
